// NETCRAFTBR COMMERCIAL DELIVERY - CANDIDATE RULES, NOT DEPLOYED.
// Intended ONLY for a new, isolated Firebase project (NOT the existing store).
// Every commercial order, webhook receipt, BDS nonce and delivery receipt is
// private. Only the trusted server-side Firebase Admin SDK may access records.
// Never grant a client user access by gamertag, nickname or browser input.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
